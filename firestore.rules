rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /{document=**} {
      allow read, write: if false;
    }

    function incoming() { return request.resource.data; }
    
    function isValidUpload(data) {
      return data.keys().hasAll(['id', 'ragaName', 'parentRaga', 'arohanam', 'avarohanam', 'shortPhrases', 'adiThalaRows', 'createdAt'])
        && data.ragaName is string && data.ragaName.size() <= 200
        && data.parentRaga is string && data.parentRaga.size() <= 200
        && data.arohanam is list
        && data.avarohanam is list
        && data.shortPhrases is list
        && data.adiThalaRows is list
        && data.createdAt == request.time;
    }

    match /swara_uploads/{uploadId} {
      // The application relies on a client-side password gate, so Firebase Auth is not used.
      // We allow anonymous creates as long as the schema is strictly validated.
      allow create: if isValidUpload(incoming());
      allow read, update, delete: if false;
    }
  }
}
